# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Optional): Configure to persist all tables in Supabase PostgreSQL.
# When omitted, the server persists data locally in data/acropole-db.json.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN PANEL AUTHENTICATION: Credentials for /admin access
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"
